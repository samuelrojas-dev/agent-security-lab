# Supabase (Project Settings > API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# SERVICE KEY: only for the intentionally vulnerable modes and the evaluator. NEVER commit it.
SUPABASE_SERVICE_KEY=your-service-role-key

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.8-flash

# Seconds to wait between LLM calls (free tier rate limits)
REQUEST_DELAY=13

# Claude (optional: python -m src.evaluate --model claude)
ANTHROPIC_API_KEY=your-anthropic-key
CLAUDE_MODEL=claude-opus-5

# Defaults for the live tests (pytest -m live): gemini | claude, local | supabase
LAB_MODEL=gemini
LAB_DATA=local
# Optional LLM judge for inference leaks in the live tests: claude | gemini (empty = off)
LAB_JUDGE=
